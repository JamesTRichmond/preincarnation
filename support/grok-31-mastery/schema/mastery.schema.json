{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PREINCARNATION mastery reference",
  "description": "Save ledger, the overlay a session files into a reserved slot, and a Witness source. Unwritten slots are not records yet.",
  "save": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "version": {
        "type": "number",
        "const": 1
      },
      "phase": {
        "type": "string",
        "enum": [
          "living",
          "afterlife"
        ]
      },
      "cycle": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "lifeId": {
        "type": "string",
        "pattern": "^life-[1-9][0-9]*$"
      },
      "lifeSerial": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "witnessBank": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "suicideStreak": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "repeatPaid": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "pays": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "pays",
            "total"
          ],
          "additionalProperties": false
        }
      },
      "escrow": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "sourceId": {
              "type": "string"
            },
            "amount": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "sourceId",
            "amount"
          ],
          "additionalProperties": false
        }
      },
      "claimedCampaign": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "claimedThisLife": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "meaningfulActs": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "owned": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "costPaid": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "bound": {
              "type": "boolean"
            }
          },
          "required": [
            "costPaid",
            "bound"
          ],
          "additionalProperties": false
        }
      },
      "loadout": {
        "type": "object",
        "properties": {
          "sockets": {
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tools": {
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forms": {
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "vow": {
            "type": [
              "string",
              "null"
            ]
          },
          "capstone": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "sockets",
          "tools",
          "forms",
          "vow",
          "capstone"
        ],
        "additionalProperties": false
      },
      "eraOpened": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "era-1",
            "era-2",
            "era-3",
            "era-4",
            "era-5",
            "era-6"
          ]
        }
      },
      "dungeonsOpened": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "lastDeathSite": {
        "type": [
          "string",
          "null"
        ]
      },
      "lastDeathCause": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "combat",
              "hazard",
              "scripted",
              "release"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "respecsThisVisit": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "journal": {
        "maxItems": 4000,
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "t": {
                  "type": "string",
                  "const": "grant"
                },
                "sourceId": {
                  "type": "string"
                },
                "lifeId": {
                  "type": "string"
                },
                "amount": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "via": {
                  "type": "string",
                  "enum": [
                    "bank",
                    "escrow"
                  ]
                }
              },
              "required": [
                "t",
                "sourceId",
                "lifeId",
                "amount",
                "via"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "t": {
                  "type": "string",
                  "const": "death"
                },
                "lifeId": {
                  "type": "string"
                },
                "cycle": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "cause": {
                  "type": "string",
                  "enum": [
                    "combat",
                    "hazard",
                    "scripted",
                    "release"
                  ]
                },
                "deathSiteKey": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "hollow": {
                  "type": "boolean"
                },
                "paid": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "paidSources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "t",
                "lifeId",
                "cycle",
                "cause",
                "deathSiteKey",
                "hollow",
                "paid",
                "paidSources"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "t": {
                  "type": "string",
                  "const": "return"
                },
                "nextLifeId": {
                  "type": "string"
                },
                "lifeSerial": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "t",
                "nextLifeId",
                "lifeSerial"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "t": {
                  "type": "string",
                  "const": "purchase"
                },
                "id": {
                  "type": "string"
                },
                "cost": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "t",
                "id",
                "cost"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "t": {
                  "type": "string",
                  "const": "respec"
                },
                "refunded": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "amount": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "id",
                      "amount"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "t",
                "refunded"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "t": {
                  "type": "string",
                  "const": "refund"
                },
                "id": {
                  "type": "string"
                },
                "amount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "t",
                "id",
                "amount"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "t": {
                  "type": "string",
                  "const": "open-era"
                },
                "era": {
                  "type": "string",
                  "enum": [
                    "era-1",
                    "era-2",
                    "era-3",
                    "era-4",
                    "era-5",
                    "era-6"
                  ]
                }
              },
              "required": [
                "t",
                "era"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "t": {
                  "type": "string",
                  "const": "open-dungeon"
                },
                "dungeon": {
                  "type": "string",
                  "pattern": "^dungeon-(0[1-9]|1[0-6])$"
                }
              },
              "required": [
                "t",
                "dungeon"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "t": {
                  "type": "string",
                  "const": "grant-bound"
                },
                "id": {
                  "type": "string"
                }
              },
              "required": [
                "t",
                "id"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "game": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "year": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "lastDeed": {
            "type": "string",
            "maxLength": 400
          },
          "incarnation": {
            "type": "string",
            "enum": [
              "wanderer",
              "smuggler",
              "officer",
              "embryo"
            ]
          },
          "skillPoints": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "karma": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "host": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "god",
                  "devil"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "saveVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name",
          "year",
          "lastDeed",
          "incarnation",
          "skillPoints",
          "karma",
          "host",
          "saveVersion"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "version",
      "phase",
      "cycle",
      "lifeId",
      "lifeSerial",
      "witnessBank",
      "suicideStreak",
      "repeatPaid",
      "escrow",
      "claimedCampaign",
      "claimedThisLife",
      "meaningfulActs",
      "owned",
      "loadout",
      "eraOpened",
      "dungeonsOpened",
      "lastDeathSite",
      "lastDeathCause",
      "respecsThisVisit",
      "journal",
      "game"
    ],
    "additionalProperties": false
  },
  "recordOverlay": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^(?:(?:quarry|creek|sugar|ash|lantern|hollow)\\.ins\\.(?:0[1-9]|1[0-2])|tool\\.(?:0[1-9]|[12][0-9]|3[0-6])|form\\.(?:0[1-9]|[12][0-9]|3[0-2])|cross\\.(?:0[1-9]|1[0-9]|2[0-4]))$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "cost": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "channel": {
        "type": "string",
        "minLength": 1
      },
      "hosts": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "slash",
            "spin",
            "walk",
            "dash",
            "swim",
            "tool:shovel",
            "tool:hookshot",
            "tool:boots",
            "tool:flippers",
            "tool:lantern",
            "tool:hammer",
            "tool:net",
            "tool:mirror",
            "tool:cape",
            "tool:cane",
            "tool:bow",
            "tool:bombs"
          ]
        }
      },
      "tier": {
        "anyOf": [
          {
            "type": "number",
            "const": 1
          },
          {
            "type": "number",
            "const": 2
          },
          {
            "type": "number",
            "const": 3
          },
          {
            "type": "number",
            "const": 4
          }
        ]
      },
      "role": {
        "type": "string",
        "enum": [
          "standard",
          "vow",
          "capstone"
        ]
      },
      "requires": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "requiresSources": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "requiresEras": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "era-1",
            "era-2",
            "era-3",
            "era-4",
            "era-5",
            "era-6"
          ]
        }
      },
      "requiresDungeons": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "excludes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "modifiers": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "op": {
              "type": "string",
              "enum": [
                "add",
                "mul",
                "flag"
              ]
            },
            "value": {
              "type": [
                "number",
                "boolean"
              ]
            }
          },
          "required": [
            "key",
            "op",
            "value"
          ],
          "additionalProperties": false
        }
      },
      "bound": {
        "type": "boolean"
      }
    },
    "required": [
      "id",
      "name",
      "summary",
      "cost",
      "channel"
    ],
    "additionalProperties": false
  },
  "witnessSource": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^src\\.(discovery|encounter|choice)\\.[a-z0-9-]+$"
      },
      "kind": {
        "type": "string",
        "enum": [
          "discovery",
          "encounter",
          "choice"
        ]
      },
      "repeat": {
        "type": "string",
        "enum": [
          "campaign",
          "life"
        ]
      },
      "amount": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "label": {
        "type": "string",
        "minLength": 1
      },
      "note": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "id",
      "kind",
      "repeat",
      "amount",
      "label",
      "note"
    ],
    "additionalProperties": false
  }
}